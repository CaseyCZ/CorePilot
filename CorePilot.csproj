<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CorePilot.ico</ApplicationIcon>
    <AssemblyName>CorePilot</AssemblyName>
    <RootNamespace>CorePilot</RootNamespace>
    <Version>2.3.0</Version>
    <Authors>CaseyCZ (based on Pidzzzz)</Authors>
    <Product>CorePilot</Product>
    <Description>A living island for Windows 10 and 11.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- The regression harness has its own entrypoint and must not be compiled
         into the production WPF application. -->
    <Compile Remove="tests\**\*.cs" />
    <Page Remove="tests\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\CorePilot.ico" />
  </ItemGroup>

</Project>
