<Window x:Class="CorePilot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:CorePilot.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Tr Key=X001}"
        Width="640" Height="460"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource VoidBrush}"
        FontFamily="{StaticResource UiFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SettingCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 3,8 L 6.5,11.5 L 13,4.5"
                                      Stroke="{DynamicResource InkBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#33CDB4FF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7FCDB4FF" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#66CDB4FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#26FFFFFF"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="15" Height="15"
                                                         Fill="{DynamicResource InkBrush}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingText" TargetType="TextBox">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Width" Value="86" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>

        <Style x:Key="SectionNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource MistBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MistBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0AFFFFFF" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="14,18,14,18">
                <TextBlock Text="{loc:Tr Key=X002}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                           Margin="8,0,0,14" />

                <ListBox x:Name="SectionList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="SectionList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource MistBrush}" />
                            <Setter Property="FontSize" Value="12.5" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9,8,9,8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#26CDB4FF" />
                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="{loc:Tr Key=X003}" />
                    <ListBoxItem Content="{loc:Tr Key=X004}" />
                    <ListBoxItem Content="{loc:Tr Key=X005}" />
                    <ListBoxItem Content="{loc:Tr Key=X006}" />
                </ListBox>

                <TextBlock Text="{loc:Tr Key=X007}"
                           FontSize="10" Foreground="{DynamicResource MistBrush}"
                           TextWrapping="Wrap" Margin="8,16,0,0" Opacity="0.8" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26,22,26,22">
            <ScrollViewer x:Name="PanelUmum" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="{loc:Tr Key=X008}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{loc:Tr Key=X009}" Style="{StaticResource SectionNote}"
                           Margin="0,5,0,16" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="{loc:Tr Key=SettingsLanguage}" FontSize="12.5"
                               Foreground="{DynamicResource InkBrush}" Width="185" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LanguageCombo" Width="155" Height="31" SelectedValuePath="Tag"
                              SelectionChanged="Language_Changed">
                        <ComboBoxItem Content="Čeština" Tag="cs"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{loc:Tr Key=SettingsMonitor}" FontSize="12.5"
                               Foreground="{DynamicResource InkBrush}" Width="185" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MonitorCombo" Width="155" Height="31" SelectedValuePath="Tag"
                              SelectionChanged="Monitor_Changed" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{loc:Tr Key=SettingsTheme}" FontSize="12.5"
                               Foreground="{DynamicResource InkBrush}" Width="185" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ThemeCombo" Width="155" Height="31" SelectedValuePath="Tag"
                              SelectionChanged="Theme_Changed">
                        <ComboBoxItem Tag="Graphite" Content="Graphite" />
                        <ComboBoxItem Tag="Void" Content="Void" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{loc:Tr Key=SettingsTimeFormat}" FontSize="12.5"
                               Foreground="{DynamicResource InkBrush}" Width="185" VerticalAlignment="Center"/>
                    <ComboBox x:Name="TimeFormatCombo" Width="155" Height="31" SelectedValuePath="Tag"
                              SelectionChanged="TimeFormat_Changed">
                        <ComboBoxItem Tag="HH:mm" />
                        <ComboBoxItem Tag="HH:mm:ss" />
                        <ComboBoxItem Tag="h:mm tt" />
                        <ComboBoxItem Tag="h:mm:ss tt" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="{loc:Tr Key=SettingsDateFormat}" FontSize="12.5"
                               Foreground="{DynamicResource InkBrush}" Width="185" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DateFormatCombo" Width="155" Height="31" SelectedValuePath="Tag"
                              SelectionChanged="DateFormat_Changed">
                        <ComboBoxItem Tag="ddd, d MMM" />
                        <ComboBoxItem Tag="dd.MM.yyyy" />
                        <ComboBoxItem Tag="d. MMMM yyyy" />
                        <ComboBoxItem Tag="dddd, d. MMMM yyyy" />
                        <ComboBoxItem Tag="yyyy-MM-dd" />
                    </ComboBox>
                </StackPanel>

                <CheckBox x:Name="EnableTransitionsCheck" Content="{loc:Tr Key=SettingsTransitions}"
                          Style="{StaticResource SettingCheck}"
                          Checked="Transitions_Toggled" Unchecked="Transitions_Toggled" />
                <CheckBox x:Name="BlackIslandBackgroundCheck" Content="{loc:Tr Key=SettingsBlackBackground}"
                          Style="{StaticResource SettingCheck}"
                          Checked="Appearance_Toggled" Unchecked="Appearance_Toggled" />
                <CheckBox x:Name="ShowNavigationArrowsCheck" Content="{loc:Tr Key=SettingsNavigationArrows}"
                          Style="{StaticResource SettingCheck}"
                          Checked="Appearance_Toggled" Unchecked="Appearance_Toggled" />

                <CheckBox x:Name="StartWithWindowsCheck" Content="{loc:Tr Key=X010}"
                          Style="{StaticResource SettingCheck}"
                          Checked="StartWithWindows_Toggled" Unchecked="StartWithWindows_Toggled" />

                <CheckBox x:Name="HotkeysCheck" Content="{loc:Tr Key=X011}"
                          Style="{StaticResource SettingCheck}"
                          Checked="Hotkeys_Toggled" Unchecked="Hotkeys_Toggled" />

                <CheckBox x:Name="FullscreenCheck" Content="{loc:Tr Key=X012}"
                          Style="{StaticResource SettingCheck}"
                          Checked="Fullscreen_Toggled" Unchecked="Fullscreen_Toggled" />

                <CheckBox x:Name="AutoLyricsCheck" Content="{loc:Tr Key=X013}"
                          Style="{StaticResource SettingCheck}"
                          Checked="AutoLyrics_Toggled" Unchecked="AutoLyrics_Toggled" />

                <CheckBox x:Name="ClipboardHistoryCheck"
                          Content="{loc:Tr Key=X014}"
                          Style="{StaticResource SettingCheck}"
                          Checked="Clipboard_Toggled" Unchecked="Clipboard_Toggled" />
                <CheckBox x:Name="KeysCheck" Content="{loc:Tr Key=X015}"
                          Style="{StaticResource SettingCheck}"
                          Checked="Keys_Toggled" Unchecked="Keys_Toggled" />
                <CheckBox x:Name="TaskbarWidgetCheck" Content="{loc:Tr Key=X016}"
                          Style="{StaticResource SettingCheck}"
                          Checked="MiniPlayer_Toggled" Unchecked="MiniPlayer_Toggled" />

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4,0,16" />

                <TextBlock Text="{loc:Tr Key=X017}" Style="{StaticResource RowLabel}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="LyricOffsetBox" Style="{StaticResource SettingText}"
                             TextChanged="LyricOffset_TextChanged"
                             LostFocus="LyricOffset_LostFocus"
                             KeyDown="LyricOffset_KeyDown" />
                    <TextBlock Text="ms" Style="{StaticResource RowLabel}" Margin="8,0,0,0"
                               Foreground="{DynamicResource MistBrush}" />
                </StackPanel>
                <TextBlock Text="{loc:Tr Key=X018}"
                           Style="{StaticResource SectionNote}" Margin="0,6,0,0" />
              </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="PanelNotch" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr Key=X004}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{loc:Tr Key=X019}"
                           Style="{StaticResource SectionNote}" Margin="0,5,0,16" />

                <CheckBox x:Name="ClickGuardCheck" Content="{loc:Tr Key=X020}"
                          Style="{StaticResource SettingCheck}"
                          Checked="ClickGuard_Toggled" Unchecked="ClickGuard_Toggled" />

                <CheckBox x:Name="AutoClickGuardCheck"
                          Content="{loc:Tr Key=X021}"
                          Style="{StaticResource SettingCheck}"
                          Checked="AutoClickGuard_Toggled" Unchecked="AutoClickGuard_Toggled" />

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4,0,16" />

                <StackPanel Margin="0,0,0,18">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr Key=X022}" Style="{StaticResource RowLabel}" />
                        <TextBlock x:Name="HoverDelayValue" Text="400 ms" Style="{StaticResource RowValue}" />
                    </Grid>
                    <Slider x:Name="HoverDelaySlider" Style="{StaticResource SettingSlider}"
                            Minimum="0" Maximum="1000" TickFrequency="50"
                            IsSnapToTickEnabled="True" ValueChanged="HoverDelay_Changed" />
                </StackPanel>

                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr Key=X023}" Style="{StaticResource RowLabel}" />
                        <TextBlock x:Name="GuardOpacityValue" Text="50 %" Style="{StaticResource RowValue}" />
                    </Grid>
                    <Slider x:Name="GuardOpacitySlider" Style="{StaticResource SettingSlider}"
                            Minimum="15" Maximum="100" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="GuardOpacity_Changed" />
                    <TextBlock Text="{loc:Tr Key=X024}"
                               Style="{StaticResource SectionNote}" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="PanelFokusAir" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr Key=X005}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{loc:Tr Key=X025}"
                           Style="{StaticResource SectionNote}" Margin="0,5,0,16" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr Key=X026}" Style="{StaticResource RowLabel}" />
                        <TextBlock Text="{loc:Tr Key=X027}" Style="{StaticResource SectionNote}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="FocusMinutesBox" Style="{StaticResource SettingText}" Width="70"
                                 TextChanged="Number_TextChanged" LostFocus="Number_LostFocus"
                                 KeyDown="Number_KeyDown" />
                        <TextBlock Text="{loc:Tr Key=X028}" Style="{StaticResource RowLabel}"
                                   Foreground="{DynamicResource MistBrush}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr Key=X029}" Style="{StaticResource RowLabel}" />
                        <TextBlock Text="{loc:Tr Key=X030}" Style="{StaticResource SectionNote}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="BreakMinutesBox" Style="{StaticResource SettingText}" Width="70"
                                 TextChanged="Number_TextChanged" LostFocus="Number_LostFocus"
                                 KeyDown="Number_KeyDown" />
                        <TextBlock Text="{loc:Tr Key=X028}" Style="{StaticResource RowLabel}"
                                   Foreground="{DynamicResource MistBrush}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4,0,16" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr Key=X031}" Style="{StaticResource RowLabel}" />
                        <TextBlock Text="{loc:Tr Key=X032}" Style="{StaticResource SectionNote}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="WaterGoalBox" Style="{StaticResource SettingText}" Width="70"
                                 TextChanged="Number_TextChanged" LostFocus="Number_LostFocus"
                                 KeyDown="Number_KeyDown" />
                        <TextBlock Text="ml" Style="{StaticResource RowLabel}"
                                   Foreground="{DynamicResource MistBrush}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr Key=X033}" Style="{StaticResource RowLabel}" />
                        <TextBlock Text="{loc:Tr Key=X034}" Style="{StaticResource SectionNote}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="ReminderBox" Style="{StaticResource SettingText}" Width="70"
                                 TextChanged="Number_TextChanged" LostFocus="Number_LostFocus"
                                 KeyDown="Number_KeyDown" />
                        <TextBlock Text="{loc:Tr Key=X028}" Style="{StaticResource RowLabel}"
                                   Foreground="{DynamicResource MistBrush}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Tr Key=X035}"
                           Style="{StaticResource SectionNote}" Margin="0,18,0,0" />
            </StackPanel>

            <StackPanel x:Name="PanelTentang" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr Key=X006}" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="VersionText" Text="CorePilot v1.3.0"
                           Style="{StaticResource RowLabel}" Margin="0,8,0,0" />
                <TextBlock Text="{loc:Tr Key=X036}"
                           Style="{StaticResource SectionNote}" Margin="0,6,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="{loc:Tr Key=X037}" Style="{StaticResource PillButton}"
                            Click="OpenSettingsFile_Click" />
                    <TextBlock VerticalAlignment="Center" Margin="18,0,0,0">
                        <Hyperlink Foreground="{DynamicResource CyanBrush}"
                                   TextDecorations="Underline"
                                   NavigateUri="https://github.com/Pidzzzz/nusa-lite/releases"
                                   RequestNavigate="ReleaseLink_RequestNavigate">
                            Lihat rilis terbaru
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20,0,18" />

                <Button Content="{loc:Tr Key=X038}" Style="{StaticResource PillButton}"
                        HorizontalAlignment="Left" Click="ResetDefaults_Click" />
                <TextBlock Text="{loc:Tr Key=X039}"
                           Style="{StaticResource SectionNote}" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
