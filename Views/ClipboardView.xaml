<UserControl x:Class="CorePilot.Views.ClipboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:CorePilot.Services"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="554" Height="252">
 <Grid Margin="17,13,17,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="{loc:Tr Key=X040}" Style="{StaticResource TitleText}" FontSize="18"/>
    <TextBlock Text="{loc:Tr Key=X041}"
               Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
   </StackPanel>
   <Button Grid.Column="1" Content="{loc:Tr Key=X042}" Click="Clear_Click"
           Style="{StaticResource PillButton}" VerticalAlignment="Center"/>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,13,0,0">
   <ItemsControl ItemsSource="{Binding Items}">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Background="{DynamicResource SoftFillBrush}" CornerRadius="13" Margin="0,0,0,8" Padding="10">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="8" Background="#2245AFC3" Margin="0,0,10,0">
         <Grid>
          <TextBlock Text="▤" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"
                     Visibility="{Binding HasImage, Converter={StaticResource InvBoolVis}}"/>
          <Image Source="{Binding Image}" Stretch="UniformToFill"
                 Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}"/>
         </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
         <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                    Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" MaxWidth="370"/>
         <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MistBrush}" FontSize="10"/>
        </StackPanel>
        <Button Grid.Column="2" Content="{loc:Tr Key=X043}" Tag="{Binding}" Click="Restore_Click"
                Style="{StaticResource PillButton}" Margin="10,0,0,0" VerticalAlignment="Center"/>
       </Grid>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </Grid>
</UserControl>