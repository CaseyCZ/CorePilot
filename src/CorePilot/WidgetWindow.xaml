<Window x:Class="CorePilot.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Width="315" Height="62" Title="CorePilot mini přehrávač" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual">
  <Border Background="#EE16213A" CornerRadius="23" BorderBrush="#627F9EB5" BorderThickness="1">
    <Grid Margin="10,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
      <Border Background="#445673" Width="40" Height="40" CornerRadius="9" ClipToBounds="True">
        <Grid><TextBlock Text="♫" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image x:Name="WidgetArt" Width="40" Height="40" Stretch="UniformToFill"/></Grid>
      </Border>
      <Button Grid.Column="1" Click="ShowIsland_Click" Background="Transparent" Padding="8,0" HorizontalContentAlignment="Left">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="WidgetTitle" Foreground="White" Text="CorePilot" FontSize="12" FontWeight="SemiBold" Width="186" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="WidgetArtist" Foreground="#B9C6D6" Text="Přehrávač" FontSize="10" Width="186" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Button>
      <Button x:Name="WidgetPlay" Grid.Column="2" Content="▶" Foreground="White" Background="#455E82" Click="Play_Click"/>
    </Grid>
  </Border>
</Window>
