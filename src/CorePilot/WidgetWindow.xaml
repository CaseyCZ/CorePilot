<Window x:Class="CorePilot.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="319" Height="70" Title="CorePilot mini přehrávač" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual">
 <Border CornerRadius="26" BorderBrush="#8F819DC8" BorderThickness="1" Background="#E21C2A47">
  <Border.Effect><DropShadowEffect BlurRadius="23" ShadowDepth="6" Opacity="0.45" Color="#030A1D"/></Border.Effect>
  <Grid Margin="10,8">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Width="45" Height="45" HorizontalAlignment="Left" Background="#566682" CornerRadius="12" ClipToBounds="True">
     <Grid><TextBlock Text="♫" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Image x:Name="WidgetArt" Width="45" Height="45" Stretch="UniformToFill"/>
     </Grid>
    </Border>
    <Button Grid.Column="1" Background="Transparent" Padding="8,0" Click="ShowIsland_Click" HorizontalContentAlignment="Left">
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="WidgetTitle" Foreground="White" FontSize="12" FontWeight="SemiBold" Width="189" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="WidgetArtist" Foreground="#B9C7DE" FontSize="10" Width="189" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
     </StackPanel>
    </Button>
    <Button x:Name="WidgetPlay" Grid.Column="2" Background="#485D81" Foreground="White"
            Content="▶" FontSize="18" Click="Play_Click" Width="39" Height="43" Padding="0"/>
   </Grid>
   <ProgressBar Grid.Row="1" x:Name="WidgetProgress" Height="3" Minimum="0" Maximum="100" Value="0" Foreground="#3EE8B6"
                Background="#20334B" BorderThickness="0" Margin="56,0,45,0"/>
  </Grid>
 </Border>
</Window>