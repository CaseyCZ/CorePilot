<Window x:Class="CorePilot.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CorePilot" Width="240" Height="46" WindowStyle="None"
 AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
 FontFamily="Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed"
 MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
 PreviewKeyDown="Island_KeyDown">
 <Grid ClipToBounds="True">
  <Border x:Name="IslandShell" Background="{DynamicResource IslandBrush}"
          BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1,0,1,1"
          CornerRadius="0,0,27,27" ClipToBounds="True">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="CompactHeader" Grid.Row="0" Margin="8,0">
     <Button Background="Transparent" Padding="0" Click="ToggleIsland_Click" ToolTip="Otevřít CorePilot">
      <Grid Height="43">
       <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
       <Grid Grid.Column="0" Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Ellipse Fill="#122A24" Stroke="#1EE0A0" StrokeThickness="1.7"/>
        <TextBlock Text="ϟ" Foreground="#55FFBC" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Grid>
       <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="ClockText" Text="11:25" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="StatusText" FontSize="9" Foreground="#63ECC0" Visibility="Collapsed" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <TextBlock Grid.Column="2" Text="▂▄▆▃" FontSize="15" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
     </Button>
    </Grid>
    <Grid x:Name="ExpandedHeader" Grid.Row="0" Margin="16,0,13,0" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse Width="7" Height="7" Fill="#1EDB9B" Margin="0,0,9,0" VerticalAlignment="Center"/>
      <TextBlock Text="CorePilot" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="SectionTitle" Text="  ·  Hudba" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="♫" Click="MediaTab_Click" ToolTip="Hudba" Width="34" Height="29" Padding="0" Margin="0,0,5,0"/>
      <Button Content="▤" Click="ClipboardTab_Click" ToolTip="Historie schránky" Width="34" Height="29" Padding="0" Margin="0,0,5,0"/>
      <Button Content="⚙" Click="SettingsTab_Click" ToolTip="Nastavení" Width="34" Height="29" Padding="0" Margin="0,0,5,0"/>
      <Button Content="✕" Click="Collapse_Click" ToolTip="Sbalit" Width="30" Height="29" Padding="0"/>
     </StackPanel>
    </Grid>
    <Grid x:Name="ExpandedBody" Grid.Row="1" Margin="18,5,18,15" Visibility="Collapsed" Opacity="0">
     <Grid x:Name="MediaSection" Height="166" VerticalAlignment="Top">
      <Grid.RowDefinitions><RowDefinition Height="77"/><RowDefinition Height="28"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Width="70" Height="70" CornerRadius="14" Background="#233346" HorizontalAlignment="Left" ClipToBounds="True">
        <Grid>
         <TextBlock x:Name="ArtworkPlaceholder" Text="♫" FontSize="31" Foreground="#80E8C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Image x:Name="AlbumImage" Width="70" Height="70" Stretch="UniformToFill"/>
        </Grid>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="TrackTitle" Text="Nic se nepřehrává" FontSize="17" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" MaxWidth="330" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="TrackArtist" Text="Spusť hudbu nebo video" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"
                   TextTrimming="CharacterEllipsis" MaxWidth="330" Margin="0,5,0,0"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="43"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="TimeElapsed" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Text="0:00"/>
       <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False"
               VerticalAlignment="Center" PreviewMouseLeftButtonUp="Seek_Released"/>
       <TextBlock x:Name="TimeRemaining" Grid.Column="2" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"
                  Text="—:—" TextAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Grid Grid.Row="2">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="|◀" FontSize="15" Click="Previous_Click" Width="42" Height="39" Padding="0" Margin="0,0,6,0"/>
        <Button x:Name="PlayButton" Content="▶" FontSize="18" Foreground="#FFFFFF" Background="#385A7D"
                Click="Play_Click" Width="50" Height="42" Padding="0" Margin="0,0,6,0"/>
        <Button Content="▶|" FontSize="15" Click="Next_Click" Width="42" Height="39" Padding="0"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="MuteButton" Content="🔊" Click="Mute_Click" Padding="0" Width="32" Height="34" Margin="0,0,4,0"/>
        <Slider x:Name="VolumeSlider" Width="97" Minimum="0" Maximum="100" Value="50"
                VerticalAlignment="Center" ValueChanged="Volume_ValueChanged"/>
        <TextBlock x:Name="VolumeLabel" Text="50 %" FontSize="10" Width="37" TextAlignment="Right"
                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" Margin="5,0,0,0"/>
       </StackPanel>
      </Grid>
     </Grid>
     <Grid x:Name="ClipboardSection" Height="267" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Historie schránky" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Lokální historie, pouze při zapnutí." FontSize="11" Foreground="{DynamicResource SecondaryBrush}"/>
       </StackPanel>
       <Button Grid.Column="1" Content="Vymazat" Click="ClearClipboard_Click" VerticalAlignment="Center"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
       <ItemsControl x:Name="ClipboardList">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Border Background="{DynamicResource ControlBrush}" CornerRadius="12" Padding="10" Margin="0,0,0,7">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
             <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="355"/>
             <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Použít" Tag="{Binding}" Click="RestoreClipboard_Click" Margin="8,0,0,0"/>
           </Grid>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
     </Grid>
     <Grid x:Name="SettingsSection" Height="292" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="Nastavení ostrůvku" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <CheckBox x:Name="HoverCheck" Content="Rozbalit při najetí myší" Click="Settings_Changed"/>
        <CheckBox x:Name="FullscreenCheck" Content="Skrýt při aplikaci na celou obrazovku" Click="Settings_Changed"/>
        <CheckBox x:Name="ClipboardCheck" Content="Historie schránky (jen v paměti)" Click="Settings_Changed"/>
        <CheckBox x:Name="WidgetCheck" Content="Mini přehrávač nad hlavním panelem" Click="Settings_Changed"/>
        <CheckBox x:Name="VolumeCheck" Content="Oznámení hlasitosti" Click="Settings_Changed"/>
        <CheckBox x:Name="KeysCheck" Content="Oznámení Caps Lock a Num Lock" Click="Settings_Changed"/>
        <CheckBox x:Name="DarkCheck" Content="Tmavý vzhled" Click="Settings_Changed"/>
        <CheckBox x:Name="AnimationsCheck" Content="Plynulé animace" Click="Settings_Changed"/>
        <TextBlock Text="Obsah schránky se neodesílá nikam na server. Při vypnutí historie se vymaže."
                   FontSize="10" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
