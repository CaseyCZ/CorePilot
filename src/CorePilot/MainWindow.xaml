<Window x:Class="CorePilot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CorePilot" Width="332" Height="80" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
 FontFamily="Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed"
 MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" PreviewKeyDown="Island_KeyDown">
 <Grid ClipToBounds="True">
  <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="TopIsland" Grid.Row="0" Width="332" Height="80" HorizontalAlignment="Center" VerticalAlignment="Top"
          CornerRadius="0,0,46,46" Background="{DynamicResource IslandBrush}"
          BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1,0,1,1">
   <Grid>
    <Grid x:Name="CompactHeader" Margin="20,0">
     <Button Background="Transparent" Padding="0" Click="ToggleIsland_Click" ToolTip="Otevřít CorePilot">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Width="43" Height="43" Background="#062219" BorderBrush="#1DE59A" BorderThickness="3"
               CornerRadius="23" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="ϟ" FontSize="27" FontWeight="Bold" Foreground="#36FFB3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="ClockText" Text="9:33" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock x:Name="StatusText" FontSize="10" Foreground="#4AF1B5" Visibility="Collapsed" MaxWidth="145" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <TextBlock Grid.Column="2" Text="▂▆▃▅" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
     </Button>
    </Grid>
    <Grid x:Name="ExpandedHeader" Visibility="Collapsed" Margin="20,0">
     <Button Background="Transparent" Padding="0" Click="Collapse_Click" ToolTip="Sbalit">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Width="43" Height="43" Background="#062219" BorderBrush="#1DE59A" BorderThickness="3"
               CornerRadius="23" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="ϟ" FontSize="27" FontWeight="Bold" Foreground="#36FFB3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=ClockText}" FontSize="28" FontWeight="Bold"
                  Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
       <TextBlock Grid.Column="2" Text="▂▆▃▅" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Grid>
     </Button>
     <TextBlock x:Name="SectionTitle" Visibility="Collapsed"/>
    </Grid>
   </Grid>
  </Border>
  <Grid x:Name="ExpandedBody" Grid.Row="1" Visibility="Collapsed" Opacity="0" VerticalAlignment="Top">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="720"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="StatusFlyout" Grid.Column="0" Width="195" Height="63" HorizontalAlignment="Center" VerticalAlignment="Top"
           Margin="0,8,0,0" CornerRadius="20" Background="{DynamicResource GlassBrush}"
           BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Color="#070E23" Opacity="0.45"/></Border.Effect>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock Text="⌨" FontSize="23" Foreground="#5AF2BD" Margin="0,0,10,0" VerticalAlignment="Center"/>
     <TextBlock x:Name="FlyoutStatusText" Text="Caps Lock vypnut" FontSize="13" FontWeight="SemiBold"
                Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
    </StackPanel>
   </Border>
   <Border x:Name="GlassPanel" Grid.Column="1" Width="720" Height="284" VerticalAlignment="Top" HorizontalAlignment="Center"
           Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}"
           BorderThickness="1.2" CornerRadius="38">
    <Border.Effect><DropShadowEffect BlurRadius="39" ShadowDepth="11" Color="#040B25" Opacity="0.55"/></Border.Effect>
    <Grid Margin="34,25,34,21">
     <Grid x:Name="MediaSection">
      <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="79"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Width="107" Height="107" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="16" ClipToBounds="True">
        <Grid>
         <Border>
          <Border.Background>
           <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EBA7C0" Offset="0"/><GradientStop Color="#8F699F" Offset="0.5"/><GradientStop Color="#183D78" Offset="1"/>
           </LinearGradientBrush>
          </Border.Background>
         </Border>
         <TextBlock x:Name="ArtworkPlaceholder" Text="♫" FontSize="39" Foreground="#EAF2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Image x:Name="AlbumImage" Width="107" Height="107" Stretch="UniformToFill"/>
        </Grid>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="TrackTitle" Text="Nic se nepřehrává" FontSize="25" FontWeight="Bold" MaxWidth="360"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryBrush}"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="TrackArtist" Text="Spusť hudbu nebo video" FontSize="16" Margin="0,6,0,0" MaxWidth="360"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryBrush}"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="▤" Click="ClipboardTab_Click" ToolTip="Schránka" Background="Transparent" Width="38" Height="36" Padding="0" FontSize="23"/>
        <Button Content="⋯" Click="SettingsTab_Click" ToolTip="Nastavení" Background="Transparent" Width="38" Height="36" Padding="0" FontSize="23"/>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions>
       <Button Grid.Column="0" Content="▤ +" Click="ClipboardTab_Click" ToolTip="Historie schránky" Background="Transparent" Width="57" Padding="0" FontSize="20"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Content="|◀" Click="Previous_Click" ToolTip="Předchozí" Background="Transparent" Width="53" Height="48" Padding="0" FontSize="20" Margin="0,0,9,0"/>
        <Button x:Name="PlayButton" Content="▶" Click="Play_Click" ToolTip="Přehrát / pozastavit"
                Background="#586681" Foreground="White" Width="65" Height="65" Padding="0" FontSize="27" Margin="0,0,9,0">
         <Button.Template>
          <ControlTemplate TargetType="Button">
           <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{TemplateBinding Background}" CornerRadius="34">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Border>
          </ControlTemplate>
         </Button.Template>
        </Button>
        <Button Content="▶|" Click="Next_Click" ToolTip="Další" Background="Transparent" Width="53" Height="48" Padding="0" FontSize="20"/>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="MuteButton" Content="🔊" Click="Mute_Click" ToolTip="Ztlumit" Background="Transparent" Padding="0" Width="34" FontSize="19"/>
        <Slider x:Name="VolumeSlider" Width="99" Minimum="0" Maximum="100" Value="50" ValueChanged="Volume_ValueChanged" VerticalAlignment="Center" Margin="6,0,0,0"/>
        <TextBlock x:Name="VolumeLabel" Text="50 %" FontSize="11" Width="37" TextAlignment="Right" Margin="7,0,0,0"
                   Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="2" Margin="0,9,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="TimeElapsed" Text="0:00" FontSize="14" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
       <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False" VerticalAlignment="Center"
               PreviewMouseLeftButtonUp="Seek_Released"/>
       <TextBlock x:Name="TimeRemaining" Text="-0:00" FontSize="14" Grid.Column="2" TextAlignment="Right"
                  Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
      </Grid>
     </Grid>
     <Grid x:Name="ClipboardSection" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,15">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Historie schránky" FontSize="23" FontWeight="Bold"/>
        <TextBlock Text="Uložené texty a obrázky, pouze lokálně" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/>
       </StackPanel>
       <Button Grid.Column="1" Content="Vymazat" Click="ClearClipboard_Click" Margin="0,0,9,0"/>
       <Button Grid.Column="2" Content="♫ Hudba" Click="MediaTab_Click"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
       <ItemsControl x:Name="ClipboardList">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Border Background="{DynamicResource ControlBrush}" CornerRadius="12" Padding="10" Margin="0,0,0,7">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
             <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="480"/>
             <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Použít" Tag="{Binding}" Click="RestoreClipboard_Click" Margin="10,0,0,0"/>
           </Grid>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
     </Grid>
     <Grid x:Name="SettingsSection" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,13">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Nastavení CorePilotu" FontSize="23" FontWeight="Bold"/>
        <TextBlock Text="Přizpůsobení ostrůvku" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/>
       </StackPanel>
       <Button Grid.Column="1" Content="♫ Hudba" Click="MediaTab_Click"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <CheckBox x:Name="HoverCheck" Content="Rozbalit při najetí myší" Click="Settings_Changed"/>
        <CheckBox x:Name="FullscreenCheck" Content="Skrýt při hře na celou obrazovku" Click="Settings_Changed"/>
        <CheckBox x:Name="ClipboardCheck" Content="Historie schránky (jen v paměti)" Click="Settings_Changed"/>
        <CheckBox x:Name="WidgetCheck" Content="Mini přehrávač nad hlavním panelem" Click="Settings_Changed"/>
        <CheckBox x:Name="VolumeCheck" Content="Oznámení hlasitosti" Click="Settings_Changed"/>
        <CheckBox x:Name="KeysCheck" Content="Oznámení Caps Lock a Num Lock" Click="Settings_Changed"/>
        <CheckBox x:Name="DarkCheck" Content="Tmavý vzhled" Click="Settings_Changed"/>
        <CheckBox x:Name="AnimationsCheck" Content="Plynulé animace" Click="Settings_Changed"/>
        <TextBlock Text="Historie schránky zůstává pouze v paměti; při vypnutí se vymaže." Margin="0,10,0,0"
                   FontSize="11" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Grid>
   </Border>
   <Border x:Name="VolumeFlyout" Grid.Column="2" Width="212" Height="63" HorizontalAlignment="Center" VerticalAlignment="Top"
           Margin="0,8,0,0" CornerRadius="20" Background="{DynamicResource GlassBrush}"
           BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Color="#070E23" Opacity="0.45"/></Border.Effect>
    <Grid Margin="16,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="33"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
     <TextBlock Text="♪" FontSize="22" Foreground="White" VerticalAlignment="Center"/>
     <ProgressBar x:Name="FlyoutVolumeBar" Grid.Column="1" Height="5" Minimum="0" Maximum="100" Value="50"
                  Foreground="#E5F0FF" Background="#465E79" VerticalAlignment="Center" BorderThickness="0"/>
     <TextBlock x:Name="FlyoutVolumeText" Grid.Column="2" FontSize="13" Text="50"
                Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>