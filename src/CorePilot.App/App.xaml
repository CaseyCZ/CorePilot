<Application x:Class="CorePilot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#0F1115"/>
        <SolidColorBrush x:Key="CardBrush" Color="#181B21"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2F38"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA4B2"/>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource PageBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
    </Application.Resources>
</Application>
