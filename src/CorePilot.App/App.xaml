<Application x:Class="CorePilot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#0F1217"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1A1F27"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#242B35"/>
        <SolidColorBrush x:Key="RowBrush" Color="#202630"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3A4452"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F7F9FC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#C4CBD6"/>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource PageBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
    </Application.Resources>
</Application>
