<Window x:Class="CorePilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CorePilot" Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CorePilot" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Hardware-aware boot media assistant · simple two-step workflow"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8" MaxWidth="460">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ActivityLog.StateText}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ActivityLog.CurrentArea}"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ActivityLog.CurrentStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,2,0,0"/>
                        <ProgressBar Height="3"
                                     Margin="0,7,0,2"
                                     IsIndeterminate="{Binding ActivityLog.IsBusy}"
                                     Value="0"/>
                        <TextBlock Text="{Binding WorkflowStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Top"
                                Margin="12,0,0,0">
                        <Button Content="Open log"
                                Click="OpenLog_OnClick"
                                Margin="0,0,0,6"/>
                        <Button Content="Support bundle"
                                Click="CreateSupportBundle_OnClick"
                                IsEnabled="{Binding CanCreateSupportBundle}"
                                ToolTip="Create a redacted troubleshooting ZIP from CorePilot diagnostics."
                                ToolTipService.ShowOnDisabled="True"
                                Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Create boot media"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="1. Verify scans the PC, searches online for usable fixes/drivers, configures the selected system and validates the prepared result.  2. Write to disk only copies the already prepared system to USB."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,6,0,20"/>

                        <TextBlock Text="System"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="SystemCombo"
                                  ItemsSource="{Binding Systems}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanChangeInputs}"
                                  SelectionChanged="SystemCombo_OnSelectionChanged"/>

                        <TextBlock Text="Version"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="VariantCombo"
                                  ItemsSource="{Binding Variants}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanChangeInputs}"
                                  SelectionChanged="VariantCombo_OnSelectionChanged"/>

                        <Button Content="Verify"
                                Click="Verify_OnClick"
                                IsEnabled="{Binding CanVerify}"
                                Height="48"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,12,0,10"/>

                        <Border Background="#12151A"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,18">
                            <TextBlock Text="{Binding PlanStatus}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>

                        <TextBlock Text="USB drive · only needed for writing"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="UsbCombo"
                                  ItemsSource="{Binding UsbDrives}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanChangeInputs}"
                                  DropDownOpened="UsbCombo_OnDropDownOpened"
                                  SelectionChanged="UsbCombo_OnSelectionChanged"/>

                        <TextBlock Text="{Binding UsbSafetyStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,10"/>

                        <Button Content="Write to disk"
                                Click="WriteToDisk_OnClick"
                                IsEnabled="{Binding CanWriteToDisk}"
                                ToolTip="{Binding WriteToDiskToolTip}"
                                ToolTipService.ShowOnDisabled="True"
                                Height="48"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,4,0,8"/>

                        <TextBlock Text="Write to disk uses the system already prepared by Verify. The selected USB is erased only after a fresh identity check, payload re-validation, verified preflight and an exact typed confirmation phrase."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"/>

                        <TextBox x:Name="ConfirmationTextBox"
                                 Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="Hardware">
                        <Grid Margin="6,12,6,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Hardware"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Hardware is scanned automatically when you press Verify."
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="#12151A" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                <TextBlock Text="{Binding DeepScanStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <ListView Grid.Row="3" ItemsSource="{Binding HardwareItems}" Background="Transparent"
                                      BorderThickness="0" Foreground="{StaticResource TextBrush}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Preparation">
                        <Grid Margin="6,12,6,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Preparation" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CompatibilitySummary}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Background="#12151A"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="INSTALLATION RESULT"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CompatibilityVerdict}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10"/>

                                    <TextBlock Text="{Binding CompatibilityInstallPath}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <TextBlock Text="Problems found / fixes / drivers / patches"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CompatibilityRequirements}"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="Automatic configuration"
                                               FontWeight="SemiBold"
                                               Margin="0,14,0,4"/>
                                    <TextBlock Text="{Binding CompatibilityAutoConfiguration}"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <ListView Grid.Row="4" ItemsSource="{Binding CompatibilityItems}" Background="Transparent"
                                      BorderThickness="0" Foreground="{StaticResource TextBrush}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="105"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StateText}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Component}" Foreground="{StaticResource MutedBrush}"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding SuggestedAction}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="Development build · Verify → Write to disk · Guarded macOS physical USB writing enabled."
                   Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
    </Grid>
</Window>
