<Window x:Class="CorePilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CorePilot" Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CorePilot" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Universal OS installer · v0.2 compatibility engine"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8">
                <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource MutedBrush}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Create boot media" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="CorePilot now checks the selected target against detected hardware before media creation."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/>

                        <TextBlock Text="System" FontWeight="SemiBold"/>
                        <ComboBox x:Name="SystemCombo" ItemsSource="{Binding Systems}" DisplayMemberPath="DisplayName"
                                  SelectionChanged="SystemCombo_OnSelectionChanged"/>

                        <TextBlock Text="Version / distribution" FontWeight="SemiBold"/>
                        <ComboBox x:Name="VariantCombo" ItemsSource="{Binding Variants}" DisplayMemberPath="DisplayName"
                                  SelectionChanged="VariantCombo_OnSelectionChanged"/>

                        <TextBlock Text="USB drive" FontWeight="SemiBold"/>
                        <ComboBox x:Name="UsbCombo" ItemsSource="{Binding UsbDrives}" DisplayMemberPath="DisplayName"/>

                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Refresh drives" Click="RefreshDrives_OnClick"/>
                            <Button Content="Prepare plan" Click="PreparePlan_OnClick"/>
                        </WrapPanel>

                        <Border Background="#12151A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,14,0,0">
                            <TextBlock Text="{Binding PlanStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                        </Border>

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding MacPlanVisibility}">
                            <TextBlock Text="macOS plan" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding MacPlanDetails}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="Hardware">
                        <Grid Margin="6,12,6,6">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Hardware scan" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="WMI/registry inventory including PCI/PNP identifiers."
                                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Scan hardware" Click="ScanHardware_OnClick"/>
                            </Grid>

                            <ListView Grid.Row="2" ItemsSource="{Binding HardwareItems}" Background="Transparent"
                                      BorderThickness="0" Foreground="{StaticResource TextBrush}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Compatibility">
                        <Grid Margin="6,12,6,6">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="macOS compatibility" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CompatibilitySummary}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <ListView Grid.Row="2" ItemsSource="{Binding CompatibilityItems}" Background="Transparent"
                                      BorderThickness="0" Foreground="{StaticResource TextBrush}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="105"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StateText}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Component}" Foreground="{StaticResource MutedBrush}"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding SuggestedAction}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="CorePilot v0.2 · Compatibility preview · USB writing remains disabled until validation is complete."
                   Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
    </Grid>
</Window>
