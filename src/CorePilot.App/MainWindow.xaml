<Window x:Class="CorePilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CorePilot" Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CorePilot" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Universal OS installer · v0.17 guided workflow actions"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8" MaxWidth="460">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ActivityLog.StateText}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ActivityLog.CurrentArea}"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ActivityLog.CurrentStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,2,0,0"/>
                        <ProgressBar Height="3"
                                     Margin="0,7,0,2"
                                     IsIndeterminate="{Binding ActivityLog.IsBusy}"
                                     Value="0"/>
                        <TextBlock Text="{Binding WorkflowStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Open log"
                            Click="OpenLog_OnClick"
                            VerticalAlignment="Top"
                            Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Create boot media" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="CorePilot checks the selected target against detected hardware before media creation."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/>

                        <TextBlock Text="System" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="SystemCombo" ItemsSource="{Binding Systems}" DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanChangeInputs}"
                                  SelectionChanged="SystemCombo_OnSelectionChanged"/>

                        <TextBlock Text="Version / distribution" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="VariantCombo" ItemsSource="{Binding Variants}" DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanChangeInputs}"
                                  SelectionChanged="VariantCombo_OnSelectionChanged"/>

                        <TextBlock Text="USB drive" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="UsbCombo" ItemsSource="{Binding UsbDrives}" DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanChangeInputs}"
                                  SelectionChanged="UsbCombo_OnSelectionChanged"/>

                        <Border Background="#12151A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <TextBlock Text="{Binding UsbSafetyStatus}" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Border>

                        <Border Background="#12151A"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,6,0,10">
                            <TextBlock Text="{Binding NextActionText}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>

                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Refresh drives"
                                    Click="RefreshDrives_OnClick"
                                    IsEnabled="{Binding CanRefreshDrives}"
                                    ToolTip="{Binding RefreshDrivesToolTip}"
                                    ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="Check USB safety"
                                    Click="InspectUsb_OnClick"
                                    IsEnabled="{Binding CanInspectUsb}"
                                    ToolTip="{Binding InspectUsbToolTip}"
                                    ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="Prepare plan"
                                    Click="PreparePlan_OnClick"
                                    IsEnabled="{Binding CanPreparePlan}"
                                    ToolTip="{Binding PreparePlanToolTip}"
                                    ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="Build EFI"
                                    Click="BuildEfi_OnClick"
                                    IsEnabled="{Binding CanBuildEfi}"
                                    ToolTip="{Binding BuildEfiToolTip}"
                                    ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="Download Recovery"
                                    Click="DownloadRecovery_OnClick"
                                    IsEnabled="{Binding CanDownloadRecovery}"
                                    ToolTip="{Binding DownloadRecoveryToolTip}"
                                    ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="Dry-run USB plan"
                                    Click="CreateUsbDryRun_OnClick"
                                    IsEnabled="{Binding CanCreateUsbDryRun}"
                                    ToolTip="{Binding CreateUsbDryRunToolTip}"
                                    ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="Execution preflight"
                                    Click="RunExecutionPreflight_OnClick"
                                    IsEnabled="{Binding CanRunPreflight}"
                                    ToolTip="{Binding RunPreflightToolTip}"
                                    ToolTipService.ShowOnDisabled="True"/>
                        </WrapPanel>

                        <TextBlock Text="Typed confirmation" FontWeight="SemiBold" Margin="0,12,0,0" Foreground="{StaticResource TextBrush}"/>
                        <TextBox x:Name="ConfirmationTextBox"
                                 MinWidth="300"
                                 IsEnabled="{Binding CanConfirmTarget}"
                                 ToolTip="{Binding ConfirmTargetToolTip}"
                                 ToolTipService.ShowOnDisabled="True"/>
                        <WrapPanel Margin="0,2,0,0">
                            <Button Content="Confirm target"
                                    Click="ConfirmTarget_OnClick"
                                    IsEnabled="{Binding CanConfirmTarget}"
                                    ToolTip="{Binding ConfirmTargetToolTip}"
                                    ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="Simulate write"
                                    Click="SimulateWrite_OnClick"
                                    IsEnabled="{Binding CanSimulateWrite}"
                                    ToolTip="{Binding SimulateWriteToolTip}"
                                    ToolTipService.ShowOnDisabled="True"/>
                        </WrapPanel>

                        <Border Background="#12151A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,14,0,0">
                            <TextBlock Text="{Binding PlanStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                        </Border>

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding MacPlanVisibility}">
                            <TextBlock Text="macOS plan" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding MacPlanDetails}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="Hardware">
                        <Grid Margin="6,12,6,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Hardware scan" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Fast local inventory + optional Hardware Sniffer deep export."
                                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1">
                                    <Button Content="Scan hardware"
                                            Click="ScanHardware_OnClick"
                                            IsEnabled="{Binding CanScanHardware}"
                                            ToolTip="{Binding ScanHardwareToolTip}"
                                            ToolTipService.ShowOnDisabled="True"/>
                                    <Button Content="Deep scan"
                                            Click="DeepScan_OnClick"
                                            IsEnabled="{Binding CanDeepScan}"
                                            ToolTip="{Binding DeepScanToolTip}"
                                            ToolTipService.ShowOnDisabled="True"/>
                                </WrapPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="#12151A" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                <TextBlock Text="{Binding DeepScanStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <ListView Grid.Row="3" ItemsSource="{Binding HardwareItems}" Background="Transparent"
                                      BorderThickness="0" Foreground="{StaticResource TextBrush}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Compatibility">
                        <Grid Margin="6,12,6,6">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="macOS compatibility" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CompatibilitySummary}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <ListView Grid.Row="2" ItemsSource="{Binding CompatibilityItems}" Background="Transparent"
                                      BorderThickness="0" Foreground="{StaticResource TextBrush}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="105"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StateText}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Component}" Foreground="{StaticResource MutedBrush}"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding SuggestedAction}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="CorePilot v0.17 preview · State-driven guided actions · Physical disk writing remains disabled."
                   Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
    </Grid>
</Window>
