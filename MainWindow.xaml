<Window x:Class="CorePilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CorePilot.Controls"
        Title="CorePilot"
        Width="760"
        Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewKeyDown="Island_PreviewKeyDown"
        Loaded="Window_Loaded"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="IslandNavArrow" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Background="Transparent">
        <StackPanel x:Name="Stack" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
            <Grid x:Name="IslandHost" Width="198" Height="34" HorizontalAlignment="Center"
                  ClipToBounds="True"
                  MouseLeftButtonDown="Island_MouseLeftButtonDown"
                  MouseLeftButtonUp="Island_MouseLeftButtonUp"
                  MouseWheel="Island_MouseWheel">
                <controls:NotchShape x:Name="Notch" Fill="{DynamicResource IslandGlassBrush}"
                                     RimBrush="{DynamicResource IslandRimBrush}"
                                     CornerRadius="12" EarRadius="0" />
                <ContentControl x:Name="ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Focusable="False" IsTabStop="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="ContentSlide" />
                    </ContentControl.RenderTransform>
                </ContentControl>
                <Button x:Name="PreviousPageButton" Panel.ZIndex="10" Content="‹"
                        Visibility="Collapsed" Width="31" Height="44" Margin="4,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Foreground="#F0F6FF" Background="Transparent"
                        BorderThickness="0" FontSize="25"
                        Padding="0" Cursor="Hand" ToolTip="Předchozí obrazovka"
                        Click="PreviousPage_Click" Style="{StaticResource IslandNavArrow}"/>
                <Button x:Name="NextPageButton" Panel.ZIndex="10" Content="›"
                        Visibility="Collapsed" Width="31" Height="44" Margin="0,0,4,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Foreground="#F0F6FF" Background="Transparent"
                        BorderThickness="0" FontSize="25"
                        Padding="0" Cursor="Hand" ToolTip="Další obrazovka"
                        Click="NextPage_Click" Style="{StaticResource IslandNavArrow}"/>
            </Grid>

            <Border x:Name="DotsBar" Margin="0,6,0,0" HorizontalAlignment="Center"
                    Background="{DynamicResource IslandGlassBrush}"
                    BorderBrush="{DynamicResource IslandRimBrush}" BorderThickness="0.7"
                    CornerRadius="12" Padding="5,4" Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DotsSlide" />
                </Border.RenderTransform>
                <StackPanel x:Name="DotsPanel" Orientation="Horizontal" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
