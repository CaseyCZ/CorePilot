<Window x:Class="CorePilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CorePilot.Controls"
        Title="CorePilot"
        Width="760"
        Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewKeyDown="Island_PreviewKeyDown"
        Loaded="Window_Loaded"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="IslandNavArrow" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="15"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#EE394764"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#EE526B91"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Background="Transparent">
        <StackPanel x:Name="Stack" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
            <Grid x:Name="IslandHost" Width="198" Height="34" HorizontalAlignment="Center"
                  ClipToBounds="True"
                  MouseLeftButtonDown="Island_MouseLeftButtonDown"
                  MouseLeftButtonUp="Island_MouseLeftButtonUp"
                  MouseWheel="Island_MouseWheel">
                <controls:NotchShape x:Name="Notch" Fill="{DynamicResource VoidBrush}" CornerRadius="12" EarRadius="0" />
                <ContentControl x:Name="ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Focusable="False" IsTabStop="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="ContentSlide" />
                    </ContentControl.RenderTransform>
                </ContentControl>
                <Button x:Name="PreviousPageButton" Panel.ZIndex="10" Content="‹"
                        Visibility="Collapsed" Width="31" Height="44" Margin="4,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Foreground="#F0F6FF" Background="#B0222B40"
                        BorderBrush="#557083A2" BorderThickness="1" FontSize="25"
                        Padding="0" Cursor="Hand" ToolTip="Předchozí obrazovka"
                        Click="PreviousPage_Click" Style="{StaticResource IslandNavArrow}"/>
                <Button x:Name="NextPageButton" Panel.ZIndex="10" Content="›"
                        Visibility="Collapsed" Width="31" Height="44" Margin="0,0,4,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Foreground="#F0F6FF" Background="#B0222B40"
                        BorderBrush="#557083A2" BorderThickness="1" FontSize="25"
                        Padding="0" Cursor="Hand" ToolTip="Další obrazovka"
                        Click="NextPage_Click" Style="{StaticResource IslandNavArrow}"/>
            </Grid>

            <Border x:Name="DotsBar" Margin="0,6,0,0" HorizontalAlignment="Center" Background="#99120A22"
                    CornerRadius="8" Padding="7,4" Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DotsSlide" />
                </Border.RenderTransform>
                <StackPanel x:Name="DotsPanel" Orientation="Horizontal" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
